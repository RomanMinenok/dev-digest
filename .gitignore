# No trailing slash: worktree sessions symlink node_modules in from the main
# checkout, and git treats a symlink as a file — `node_modules/` would miss it.
node_modules
dist/
# agent-runner's bundled dist/ MUST be committed: `server/src/modules/ci/files.ts`
# reads it at export time and embeds it in the target repo as
# `.devdigest/runner/index.js`, which their workflow runs with `node` as-is —
# nothing rebuilds it downstream. Keep agent-runner/.gitignore free of a `dist/`
# rule, or these re-includes are silently overridden.
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
/server/eval-logs/*md
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json
.claude/settings.local.json
