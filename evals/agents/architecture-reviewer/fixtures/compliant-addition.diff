+import type { Finding } from '@devdigest/shared';
+
+/**
+ * Stable presentation order for grounded findings: by file path, then by the
+ * first line of the cited range. Pure — no I/O, no clock, no randomness, and
+ * no severity logic (severity ranking already lives in output/to-review.ts).
+ */
+export function sortFindingsByLocation(findings: Finding[]): Finding[] {
+  return [...findings].sort(
+    (a, b) => a.file.localeCompare(b.file) || a.start_line - b.start_line,
+  );
+}
