+import type { Finding, Severity } from "../types.js";
+
+const ORDER: Record<Severity, number> = {
+  critical: 0,
+  high: 1,
+  medium: 2,
+  low: 3,
+  info: 4,
+};
+
+/** Sort findings most-severe first. Pure — no I/O, no clock, no randomness. */
+export function sortBySeverity(findings: Finding[]): Finding[] {
+  return [...findings].sort((a, b) => ORDER[a.severity] - ORDER[b.severity]);
+}
+
+/** True when any finding is at or above the blocking threshold. */
+export function hasBlocking(findings: Finding[]): boolean {
+  return findings.some((f) => ORDER[f.severity] <= ORDER.high);
+}
