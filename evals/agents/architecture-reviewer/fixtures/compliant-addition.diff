+import type { Finding } from '@devdigest/shared';
+
+/**
+ * Severity ordering for findings. Pure — no I/O, no clock, no randomness, and
+ * no dependency on anything outside the shared contracts.
+ */
+
+const ORDER: Record<string, number> = {
+  CRITICAL: 0,
+  WARNING: 1,
+  SUGGESTION: 2,
+};
+
+const rank = (f: Finding): number => ORDER[f.severity] ?? Number.MAX_SAFE_INTEGER;
+
+/** Sort findings most-severe first. Does not mutate the input. */
+export function sortBySeverity(findings: Finding[]): Finding[] {
+  return [...findings].sort((a, b) => rank(a) - rank(b));
+}
